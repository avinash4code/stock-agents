# Copy to .env and fill in. Real environment variables take precedence over this file.
# Provider: anthropic | deepseek
LLM_PROVIDER=deepseek

# Set the key for the provider you use
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides (defaults: deepseek-chat / claude-sonnet-5-5).
# Reasoning models spend max tokens on hidden thinking too: keep LLM_MAX_TOKENS generous or replies come back cut off/empty.
# LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=16000
# Optional: custom API endpoint / gateway
# LLM_BASE_URL=

# Optional: give one agent its own model (agents: NEWS, MACRO, FUNDAMENTALS, OUTLOOK). Unset values are inherited;
# a different provider uses that provider's API key and default model, and does not inherit LLM_BASE_URL.
# LLM_FUNDAMENTALS_MODEL=deepseek-v4-pro
# LLM_OUTLOOK_PROVIDER=anthropic
# LLM_OUTLOOK_MODEL=claude-sonnet-5-5
# LLM_OUTLOOK_TEMPERATURE=0.3   # temperature per agent (DeepSeek only; Anthropic models do not take one)
# (also LLM_<AGENT>_MAX_TOKENS and LLM_<AGENT>_BASE_URL)

# Optional: where reports are stored (default: data/stock_analyst.db next to this file)
# STOCK_ANALYST_DB=

# Reuse a stored news / macro report instead of re-running that agent, if it is newer than this many hours
# (applies to `stock-analyst all`; 0 = always re-run). Override per run with --max-news-age / --max-macro-age / --max-fundamentals-age.
# STOCK_ANALYST_NEWS_MAX_AGE_HOURS=6
# STOCK_ANALYST_MACRO_MAX_AGE_HOURS=6
# Quarterly results change rarely, so the fundamentals report is reused for a week by default.
# STOCK_ANALYST_FUNDAMENTALS_MAX_AGE_HOURS=168
